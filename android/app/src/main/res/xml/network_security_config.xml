<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <!-- Supabase -->
        <domain includeSubdomains="true">supabase.co</domain>
        <!-- XRP Testnet -->
        <domain includeSubdomains="true">rippletest.net</domain>
        <!-- XRP Mainnet -->
        <domain includeSubdomains="true">xrplcluster.com</domain>
        <!-- VALR -->
        <domain includeSubdomains="true">valr.com</domain>
        <!-- Google APIs -->
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
    </domain-config>
    <!-- Allow cleartext only in debug builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
