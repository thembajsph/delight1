# ─────────────────────────────────────────────────────────────────────────────
# Delight Backend — Environment Variables
# Copy to .env and fill in your real values
# NEVER commit .env to Git
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Supabase (your backend uses the SERVICE ROLE key — never expose in Flutter app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ... (service role key from Supabase dashboard)
SUPABASE_ANON_KEY=eyJ... (anon key — safe to use in Flutter app)

# XRP Ledger
# Set XRPL_NETWORK=testnet for development, mainnet for production
XRPL_NETWORK=testnet
XRPL_TESTNET_WS=wss://s.altnet.rippletest.net:51233
XRPL_MAINNET_WS=wss://xrplcluster.com
# Platform wallet (collects fees — keep this key secret!)
PLATFORM_XRP_ADDRESS=rYOUR_PLATFORM_WALLET_ADDRESS
PLATFORM_XRP_SECRET=sYOUR_PLATFORM_WALLET_SECRET

# VALR Exchange (ZAR <-> XRP swaps)
# Get keys from: https://valr.com/account/api
# Required permissions: View + Trade (NOT Withdraw)
VALR_API_KEY=YOUR_VALR_API_KEY
VALR_API_SECRET=YOUR_VALR_API_SECRET

# Ozow (SA Instant EFT)
# Apply at: https://ozow.com/developers (3 day approval)
OZOW_SITE_CODE=YOUR_OZOW_SITE_CODE
OZOW_PRIVATE_KEY=YOUR_OZOW_PRIVATE_KEY
OZOW_API_KEY=YOUR_OZOW_API_KEY

# Stitch Money (PayShap)
# Apply at: https://stitch.money
STITCH_CLIENT_ID=YOUR_STITCH_CLIENT_ID
STITCH_CLIENT_SECRET=YOUR_STITCH_CLIENT_SECRET

# Firebase Admin (push notifications)
# Download service account JSON from Firebase Console
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# Redis (for job queues)
# Railway provides Redis — grab the URL from your Railway project
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your-very-long-random-secret-here
WEBHOOK_SECRET=another-random-secret-for-webhook-validation
